---
type SlotChild = {
  Component: (props: Record<string, unknown>) => unknown
  props?: Record<string, unknown>
  slot?: string
  slotIsHtml?: boolean
  children?: SlotChild[]
}

interface Props {
  Component: (props: Record<string, unknown>) => unknown
  slot?: string
  slotIsHtml?: boolean
  children?: SlotChild[]
  tooltipSlot?: string
  tooltipSlotIsHtml?: boolean
  before?: string
  beforeIsHtml?: boolean
  after?: string
  afterIsHtml?: boolean
  [key: string]: unknown
}

const {
  Component,
  slot = 'Label',
  slotIsHtml = false,
  children = [],
  tooltipSlot,
  tooltipSlotIsHtml = false,
  before,
  beforeIsHtml = false,
  after,
  afterIsHtml = false,
  ...rest
} = Astro.props

---

{before &&
  (beforeIsHtml ? <Fragment set:html={before ?? ''} /> : before)}
<Component {...rest}>
  {children.length > 0
    ? children.map((item) => (
        <item.Component {...(item.props ?? {})}>
          {item.children && item.children.length > 0
            ? item.children.map((child) => (
                <child.Component {...(child.props ?? {})}>
                  {child.slotIsHtml ? (
                    <Fragment set:html={child.slot ?? ''} />
                  ) : (
                    child.slot
                  )}
                </child.Component>
              ))
            : item.slotIsHtml ? (
                <Fragment set:html={item.slot ?? ''} />
              ) : (
                item.slot
              )}
        </item.Component>
      ))
    : slotIsHtml ? (
        <Fragment set:html={slot} />
      ) : (
        slot
      )}
  {tooltipSlot !== undefined && (
    <span slot="tooltip">
      {tooltipSlotIsHtml ? <Fragment set:html={tooltipSlot} /> : tooltipSlot}
    </span>
  )}
</Component>
{after &&
  (afterIsHtml ? <Fragment set:html={after ?? ''} /> : after)}
